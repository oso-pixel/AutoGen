# ============================================================
# Archivo de EJEMPLO: no contiene claves reales.
# Copíalo como .env y coloca tu propia API key.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env
#
# El script usa OPENAI_API_KEY si tiene una clave real; si no,
# usa DEEPSEEK_API_KEY. Deja el placeholder "tu_api_key_aqui"
# en el proveedor que no vayas a usar.
# ============================================================

# --- Opción DeepSeek (la que usa esta demo) ---
DEEPSEEK_API_KEY=tu_api_key_aqui
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# --- Opción OpenAI (opcional) ---
OPENAI_API_KEY=tu_api_key_aqui
OPENAI_MODEL=gpt-4o-mini
